{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "lib": [
            "es2020",
            "DOM"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "resolveJsonModule": true,
        "moduleResolution": "node",
        "baseUrl": ".",
        "paths": {
            "@shared/*": ["../shared/*"],
            "zod": ["./node_modules/zod"]
        }
    },
    "include": [
        "src/**/*",
        "../shared/types/**/*",
        "../shared/utils/**/*"
    ],
    "exclude": [
        "node_modules",
        "**/*.test.ts"
    ]
}